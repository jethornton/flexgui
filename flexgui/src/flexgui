class KeyboardJog(QObject):
	# LinuxCNC keyboard jogging class

	# Widget types that use arrow keys for native navigation
	JOG_DISABLE_TYPES = (
		QLineEdit, QPlainTextEdit, QListWidget, QRadioButton, 
		QListView, QComboBox, QSpinBox, QDoubleSpinBox
	)

	# Map keys to (axis_id, direction)
	KEY_JOG_MAP = {
		Qt.Key.Key_Left: (0, 'neg'),
		Qt.Key.Key_Right: (0, 'pos'),
		Qt.Key.Key_Up: (1, 'pos'),
		Qt.Key.Key_Down: (1, 'neg'),
		Qt.Key.Key_PageUp: (2, 'pos'),
		Qt.Key.Key_PageDown: (2, 'neg')
	}

	def __init__(self, window):
		super().__init__()
		self.window = window
		self._keyboard_jog_state = window.kb_jog_cb_enabled

	def eventFilter(self, source, event):
		event_type = event.type()

		if event_type == QEvent.Type.FocusIn:
			self._handle_focus_in(source)
		elif event_type == QEvent.Type.FocusOut:
			self._handle_focus_out(source)
		elif event_type == QEvent.Type.KeyPress:
			if self._handle_key_press(event):
				return True
		elif event_type == QEvent.Type.KeyRelease:
			if self._handle_key_release(event):
				return True
		elif event_type == QEvent.Type.MouseButtonRelease:
			self._handle_mouse_release(source)
		elif event_type == QEvent.Type.MouseButtonPress:
			self._handle_mouse_press(source)

		return super().eventFilter(source, event)

	def _set_ui_jog_enabled(self, enabled):
		"""Helper to safely toggle UI checkbox or window variable state."""
		if 'keyboard_jog_cb' in self.window.child_names:
			getattr(self.window, 'keyboard_jog_cb').setChecked(enabled)
		else:
			self.window.kb_jog_cb_enabled = enabled

	def _handle_focus_in(self, source):
		if self.window.kb_jog_focus and isinstance(source, self.JOG_DISABLE_TYPES):
			self._keyboard_jog_state = self.window.kb_jog_cb_enabled
			self._set_ui_jog_enabled(False)

	def _handle_focus_out(self, source):
		if self.window.kb_jog_focus and isinstance(source, self.JOG_DISABLE_TYPES):
			self._set_ui_jog_enabled(self._keyboard_jog_state)

	def _handle_key_press(self, event):
		if self.window.probing:
			return False

		# Handle numeric jog increment changes (Ctrl + 0-9)
		if (self.window.kb_jog_increment and 
			self.window.status.state != emc.RCS_EXEC and 
			event.modifiers() & Qt.KeyboardModifier.ControlModifier and 
			Qt.Key.Key_0 <= event.key() <= Qt.Key.Key_9):

				number = chr(event.key())
				utilities.set_jog_increment(self.window, int(number))
				return True

		# Handle motion jogging
		if self.window.status.task_state == emc.STATE_ON and self.window.status.task_mode == emc.MODE_MANUAL:
			ctrl_pressed = event.modifiers() & Qt.KeyboardModifier.ControlModifier
			if (self.window.kb_jog_ctrl_enabled and ctrl_pressed) or self.window.kb_jog_cb_enabled:
				if event.key() in self.KEY_JOG_MAP:
					if event.isAutoRepeat():
						return True
					axis, direction = self.KEY_JOG_MAP[event.key()]
					commands.keyboard_jog(self.window, True, axis, direction)
					return True
		return False

	def _handle_key_release(self, event):
		if not (self.window.kb_jog_cb_enabled or self.window.kb_jog_ctrl_enabled):
			return False
		if self.window.status.task_state != emc.STATE_ON or event.isAutoRepeat():
			return False

		match event.key():
			case Qt.Key.Key_Left | Qt.Key.Key_Right:
				commands.keyboard_jog(self.window, False, 0)
				return True
			case Qt.Key.Key_Up | Qt.Key.Key_Down:
				commands.keyboard_jog(self.window, False, 1)
				return True
			case Qt.Key.Key_PageUp | Qt.Key.Key_PageDown:
				commands.keyboard_jog(self.window, False, 2)
				return True
			case Qt.Key.Key_Control:
				commands.keyboard_jog(self.window, False)
				return True
		return False

	def _handle_mouse_release(self, source):
		name = source.objectName()
		if name in self.window.number_le:
			dialogs.numbers(self.window, source)
		elif name in self.window.nccode_le:
			dialogs.gcode(self.window, source)
		elif name in self.window.keyboard_le:
			dialogs.keyboard(self.window, source)
		elif name in self.window.touch_sb:
			dialogs.spinbox_numbers(self.window, source.parent())
		elif name in self.window.nc_viewer:
			utilities.update_start_line(self.window)

	def _handle_mouse_press(self, source):
		if self.window.kb_jog_focus:
			if not isinstance(source, self.JOG_DISABLE_TYPES) and not isinstance(source.parent(), self.JOG_DISABLE_TYPES):
				focused = QApplication.focusWidget()
				if isinstance(focused, self.JOG_DISABLE_TYPES):
					focused.clearFocus()

class flexgui(QMainWindow):
	def __init__(self):
		super().__init__()

		self.flex_version = '2.0.1'

		self.path = os.path.dirname(os.path.realpath(sys.argv[0]))
		# set the library path
		if self.path == '/usr/bin':
			self.lib_path = '/usr/lib/libflexgui'
		else: # this test checks for proper install directory
			msg_box = QMessageBox()
			msg_box.setIcon(QMessageBox.Icon.Critical)
			msg_box.setText('Flex GUI seems to be installed in a none standard location.')
			msg_box.setInformativeText('Flex GUI will shut down!')
			msg_box.setStandardButtons(QMessageBox.StandardButton.Ok)
			msg_box.exec()
			sys.exit()

		for i in range(len(sys.argv)): # check if running from ini DISPLAY entry
			if sys.argv[i].endswith('.ini'):
				# the full path to the ini file
				self.ini_path = sys.argv[i]
				# the path to the configuration directory
				self.config_path = os.path.split(sys.argv[i])[0]
				# the ini file object
				self.inifile = emc.ini(sys.argv[i])
				break
		else: # verified
			title = 'Error'
			msg = ('Flex GUI must be called from the LinuxCNC ini file.')
			dialogs.error_msg_ok(self, title, msg)
			sys.exit()

		# connect to linuxcnc
		self.status = emc.stat()
		self.status.poll() # poll for startup
		self.command = emc.command()
		self.error = emc.error_channel()

		self.tool_in_spindle = self.status.tool_in_spindle
		self.help_dialog = None
		self.keyboard_jogging = False

		self.home_dir = os.path.expanduser('~')
		self.config_dir = os.path.dirname(self.status.ini_filename)

		# setup hal components
		self.halcomp = hal.component('flexhal')
		self.toolcomp = hal.component('tool-change')

		# display splash screen if found
		splash_image = self.inifile.find('FLEXGUI', 'SPLASH_IMAGE') or False
		splash_title = self.inifile.find('FLEXGUI', 'SPLASH_TITLE') or 'Flex the Dragon Slayer'
		splash_time = self.inifile.find('FLEXGUI', 'SPLASH_TIME') or 5
		splash_font = self.inifile.find('FLEXGUI', 'SPLASH_FONT') or 'Monospace'
		splash_font_size = self.inifile.find('FLEXGUI', 'SPLASH_FONT_SIZE') or 12

		if isinstance(splash_font_size, str): splash_font_size = utilities.to_int(splash_font_size) 
		splash_font_bold = self.inifile.find('FLEXGUI', 'SPLASH_FONT_BOLD') or 'false'
		splash_font_bold = splash_font_bold.strip().lower() == True
		splash_font_color = self.inifile.find('FLEXGUI', 'SPLASH_FONT_COLOR') or 'black'

		if isinstance(splash_time, str):
			splash_time = int(splash_time)
		if splash_image:
			if os.path.isfile(splash_image):
				splash_pix = QPixmap(splash_image)
				splash = QSplashScreen(splash_pix, Qt.WindowType.WindowStaysOnTopHint)
				# Set font for the splash screen
				font = QFont(splash_font, splash_font_size) # Font Family and Size
				font.setBold(splash_font_bold)
				splash.setFont(font)
				splash.show()
				app.processEvents()
				for i in range(10):
					time.sleep(splash_time/10)
					percent_done = 10 * i
					msg = f'{splash_title}\nLoading ... {percent_done:.0f}%'
					splash.showMessage(msg, Qt.AlignmentFlag.AlignBottom |
						Qt.AlignmentFlag.AlignCenter, QColor(splash_font_color))
					app.processEvents()
			else: # verified
				title = 'Configuration Error'
				msg = (f'The Splash Image "{splash_image}" was not found in the '
				'configuration directory.')
				info = 'The Splash Image will not load!'
				dialogs.error_msg_ok(self, title, msg, info)

		# find and load the gui
		gui_file = self.inifile.find('DISPLAY', 'GUI') or False
		if gui_file: # gui is in the ini file
			gui_path = os.path.join(self.config_dir, gui_file)
			if not os.path.isfile(gui_path): # gui not found
				gui_path = os.path.join(self.lib_path, 'flex_default.ui')
				gui_file = 'flex_default.ui'
		else: # no gui specified
			gui_path = os.path.join(self.lib_path, 'flex_default.ui')
			gui_file = 'flex_default.ui'

		loadUi(gui_path, self)
		machine = self.inifile.find('EMC', 'MACHINE') or False
		if machine:
			self.setWindowTitle(f'{machine} Flex GUI V{self.flex_version}')
		else:
			self.setWindowTitle(f'Flex GUI - Version: {self.flex_version} - Using {gui_file}')

		# get a list of axis letters in the configuration
		axis_list = ['X', 'Y', 'Z', 'A', 'B', 'C', 'U', 'V', 'W']
		axis_map = f'{self.status.axis_mask:09b}'
		self.axis_letters = []
		for i, a in enumerate(reversed(axis_map)):
			if a == '1':
				self.axis_letters.append(axis_list[i])

		# get the number of axes and joints
		self.axis_count = self.status.axis_mask.bit_count()

		# get ini values if any before trying to use them
		read_ini.read(self)

		# check for a resources.py file with images for the stylesheet
		if self.resources_file: # import the resources file
			try:
				sys.path.append(self.config_path)
				import resources
			except: # verified
				title = 'Import Failed'
				msg = (f'The resources file "{self.resources_file}" was not found or it '
				'contained errors. The file name must be "resources.py" to be imported. '
				'If it is there then rebuild it with the Flex Resource Tool.')
				dialogs.error_msg_ok(self, title, msg)

		stylesheet = False
		if self.theme:
			valid_themes = ['keyboard', 'touch', 'blue', 'blue-touch', 'dark', 'dark-touch']
			if self.theme in valid_themes:
				stylesheet = os.path.join(self.lib_path, f'{self.theme}.qss')
				from libflexgui import resources
		elif self.qss_file: # use a local qss file
			stylesheet = os.path.join(self.config_path, self.qss_file)

		if stylesheet:
			if os.path.isfile(stylesheet):
				with open(stylesheet, 'r') as f:
					self.setStyleSheet(f.read())
			else: # verified
				title = 'INI Error!'
				msg = (f'The Stylesheet "{stylesheet}" was not found.')
				dialogs.error_msg_ok(parent, title, msg)

		# set emc states to -0 so they get evaluated in status at least once
		self.exec_state = -0
		self.interp_state = -0
		self.interpreter_errcode = -0
		self.motion_mode = -0
		self.motion_type = -0
		self.state = -0
		self.task_mode = -0
		self.task_state = -0
		self.file = -0
		self.flood_state = -0
		self.mist_state = -0

		startup.set_screen(self)
		startup.setup_vars(self)
		startup.setup_hal_led_text_labels(self)
		startup.setup_hal_led_buttons(self)
		startup.setup_hal_led_labels(self)
		startup.setup_hal_leds(self)
		startup.find_children(self)
		startup.setup_menus(self) # setup menus adds to child names
		startup.setup_actions(self) # setup actions adds to child names
		startup.setup_enables(self) # menus must run before setup enables
		startup.update_check(self)
		startup.setup_plot(self)
		startup.setup_buttons(self)
		startup.setup_status_labels(self)
		startup.setup_list_widgets(self)
		startup.setup_plain_text_edits(self)
		startup.setup_stacked_widgets(self)
		startup.setup_spin_boxes(self)
		startup.setup_line_edits(self)
		startup.setup_spindle(self)
		startup.setup_jog(self)
		startup.setup_jog_selected(self)
		startup.setup_probing(self)
		startup.setup_mdi(self)
		startup.setup_mdi_buttons(self)
		startup.setup_set_var(self)
		startup.setup_watch_var(self)
		startup.setup_tool_change(self)
		startup.setup_tool_change_buttons(self)
		startup.setup_manual_tool_change(self)
		startup.setup_tool_touchoff(self)
		startup.setup_tool_touchoff_selected(self)
		startup.setup_hal(self)
		startup.setup_hal_io_state(self)
		startup.setup_hal_watch(self)
		startup.setup_touchoff(self)
		startup.setup_touchoff_selected(self)
		startup.setup_sliders(self)
		startup.setup_overrides(self)
		startup.setup_defaults(self)
		startup.setup_toolbar(self)
		startup.setup_fsc(self)
		startup.setup_dsf(self)
		startup.setup_tpc(self)
		startup.setup_help(self)
		startup.setup_tabs(self)

		# loading the post gui files can only happen once
		startup.load_postgui(self)

		# setup QProcess for tool editor
		self.tool_edit_process = QProcess()
		self.tool_edit_process.finished.connect(partial(actions.action_reload_tool_table, self))

		self.user_timer = QTimer()
		startup.setup_import(self) # do this after user timer is created

		# setup and start the status update timer
		self.update_timer = QTimer()
		self.update_timer.timeout.connect(partial(status.update, self))
		self.update_timer.start(self.cycle_time) # milliseconds

		# setup the var file watch timer
		self.var_watch_timer = QTimer(self)
		self.var_watch_timer.timeout.connect(partial(utilities.var_file_watch, self))
		self.var_mod_time = 0.0 # used to watch the file modification time
		self.var_watch_timer.start(1000) # milliseconds

		# setup the i/o watch timer
		self.io_watch_timer = QTimer(self)
		self.io_watch_timer.timeout.connect(partial(utilities.io_watch, self))
		self.io_watch_timer.start(1000) # milliseconds

		# flashing button timer
		self.button_flash_timer = QTimer(self)
		self.button_flash_timer.timeout.connect(partial(utilities.flash_buttons, self))
		self.button_flash_timer.start(self.flash_time) # milliseconds

		# install the KeyboardJog event filter
		self.keyboard_jog = KeyboardJog(self)
		app.installEventFilter(self.keyboard_jog)

		# set the inital screen size
		match self.screen_size:
			case 'minimized':
				self.showMinimized()
			case 'normal':
				self.showNormal()
			case 'maximized':
				self.showMaximized()
			case 'full':
				self.showFullScreen()
			case 'rpi_full':
				self.show()
				self.windowHandle().setWindowState(Qt.WindowState.WindowFullScreen)
			case _:
				self.show()

	def closeEvent(self, event):
		# 1. Stop all user-defined timers immediately
		self.user_timer.stop()
		self.update_timer.stop()
		self.var_watch_timer.stop()
		self.io_watch_timer.stop()
		self.button_flash_timer.stop()

		# 2. Safely close any loose child dialogs
		if self.help_dialog is not None:
			self.help_dialog.close()


		# 4. Explicitly disconnect and delete LinuxCNC backend references
		# This prevents the C-extension from tracking a dead GUI object
		if hasattr(self, 'error') and self.error:
			try:
				self.error.poll()  # Clear out any residual messages
			except Exception:
				pass
			del self.error

		if hasattr(self, 'status'):
			del self.status

		if hasattr(self, 'command'):
			del self.command

		# 4. Save settings *after* timers are dead but *before* objects dissolve
		shutdown.save_settings(self)

		# 5. Explicitly tell Qt that it is allowed to close the window
		event.accept()
		os._exit(0)  # Forces Linux to reclaim the memory without running broken C++ cleanups

